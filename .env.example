# Settings template for the seed42 audio module. Copy this file to .env and
# put the real values there. .env is gitignored, so real values never reach
# the repo. Keep this template free of them too.
#
# Nothing reads .env on its own. Load it into the terminal before a run:
#   macOS or Linux:  set -a; source .env; set +a
#   Windows:         set each one by hand, for example  set SEED42_STAGE=1
# In .env, wrap the password in single quotes if it has symbols in it.

# The account seed42 issues for the Control API. Read by output/writer.py.
# The live address is set in output/writer.py (BASE_URL), not here.
SEED42_EMAIL=
SEED42_PASSWORD=

# Which Stage writes the prompt: 1 rule table, 2 CLAP retrieval, 3 local LLM.
# Read by orchestrate.py. Defaults to 1 if left out.
SEED42_STAGE=1

# Field allow-list, for reference. These are the only fields the writer will
# send to a running stream. Anything else reloads the stream for about 30
# seconds. The writer enforces its own copy (HOT_FIELDS and
# ALLOWED_CONTROLNET_FIELDS in output/writer.py) and does not read this file,
# so a mistake here can never let a cold field through. Keep the two in step.
#   prompt, negative_prompt, seed, t_index_list, guidance_scale, delta,
#   num_inference_steps, controlnets (conditioning_scale only, in each entry)